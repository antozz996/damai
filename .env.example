DATABASE_URL=postgresql://...

# Dominio pubblico di questo backend: base dei link al biglietto (/ticket/<token>)
PUBLIC_BASE_URL=https://registrazioni.damaigarden.it
# Dominio codificato nel QR per lo staff (/admin/checkin/<token>). Se assente usa PUBLIC_BASE_URL.
STAFF_BASE_URL=https://registrazioni.damaigarden.it
# Pagina pubblica dell'evento sul sito (a cui punta il QR del volantino)
PUBLIC_PAGE_URL=https://www.damaigarden.it/christmas-village/

# Edizione corrente: filtra fasce e registrazioni (default natale-2026)
EVENT_EDITION=natale-2026
# Registrazioni aperte solo con il valore esatto "true"; altrimenti le rotte pubbliche rispondono 410
REGISTRATIONS_OPEN=false
# Origini autorizzate a chiamare /api/slots e /api/register dal browser (separate da virgola)
CORS_ALLOWED_ORIGINS=https://www.damaigarden.it,https://damaigarden.it,http://localhost:3000,http://localhost:3111
# Facoltativo: registrazione walk-in self-service senza login
WALK_IN_PUBLIC=false

ADMIN_USER=damai
ADMIN_PASSWORD=change-me
CRON_SECRET=change-me-long-random

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=Damai Christmas Village <eventi@damaigarden.it>
EMAIL_REPLY_TO=

# WhatsApp Cloud API (optional until templates are approved)
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_TEMPLATE_CONFIRMATION=damai_christmas_village_conferma
WA_TEMPLATE_REMINDER_48H=damai_christmas_village_48h
WA_TEMPLATE_REMINDER_24H=damai_christmas_village_promemoria
WA_TEMPLATE_THANK_YOU=damai_christmas_village_grazie
